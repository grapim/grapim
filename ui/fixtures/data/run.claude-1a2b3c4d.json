                "t": "+",
                "s": "import { randomUUID } from 'node:crypto';"
              },
              {
                "t": "+",
                "s": "import { getCart } from '../checkout/cart';"
              },
              {
                "t": "+",
                "s": "import type { Money } from '../types';"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "export interface Invoice {"
              },
              {
                "t": "+",
                "s": "  id: string;"
              },
              {
                "t": "+",
                "s": "  cartId: string;"
              },
              {
                "t": "+",
                "s": "  total: Money;"
              },
              {
                "t": "+",
                "s": "  status: 'open' | 'paid' | 'refunded' | 'void';"
              },
              {
                "t": "+",
                "s": "  refunded?: Money;"
              },
              {
                "t": "+",
                "s": "  createdAt: string;"
              },
              {
                "t": "+",
                "s": "}"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "const invoices = new Map<string, Invoice>();"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "export async function createInvoice(cartId: string): Promise<Invoice> {"
              },
              {
                "t": "+",
                "s": "  const cart = await getCart(cartId);"
              },
              {
                "t": "+",
                "s": "  if (cart.items.length === 0) throw new Error('Cannot invoice an empty cart');"
              },
              {
                "t": "+",
                "s": "  const invoice: Invoice = {"
              },
              {
                "t": "+",
                "s": "    id: `inv_${randomUUID().slice(0, 12)}`,"
              },
              {
                "t": "+",
                "s": "    cartId,"
              },
              {
                "t": "+",
                "s": "    total: cart.total,"
              },
              {
                "t": "+",
                "s": "    status: 'open',"
              },
              {
                "t": "+",
                "s": "    createdAt: new Date().toISOString(),"
              },
              {
                "t": "+",
                "s": "  };"
              },
              {
                "t": "+",
                "s": "  invoices.set(invoice.id, invoice);"
              },
              {
                "t": "+",
                "s": "  return invoice;"
              },
              {
                "t": "+",
                "s": "}"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "export async function getInvoice(id: string): Promise<Invoice | undefined> {"
              },
              {
                "t": "+",
                "s": "  return invoices.get(id);"
              },
              {
                "t": "+",
                "s": "}"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "export async function refundInvoice(id: string, amount?: number): Promise<Invoice> {"
              },
              {
                "t": "+",
                "s": "  const invoice = invoices.get(id);"
              },
              {
                "t": "+",
                "s": "  if (!invoice) throw new Error(`No invoice ${id}`);"
              },
              {
                "t": "+",
                "s": "  if (invoice.status !== 'paid') throw new Error(`Invoice ${id} is ${invoice.status}, not paid`);"
              },
              {
                "t": "+",
                "s": "  const refund = amount ?? invoice.total.amount;"
              },
              {
                "t": "+",
                "s": "  if (refund <= 0 || refund > invoice.total.amount) throw new Error('Refund must be between 0 and the invoice total');"
              },
              {
                "t": "+",
                "s": "  invoice.refunded = { amount: refund, currency: invoice.total.currency };"
              },
              {
                "t": "+",
                "s": "  invoice.status = refund === invoice.total.amount ? 'refunded' : 'paid';"
              },
              {
                "t": "+",
                "s": "  return invoice;"
              },
              {
                "t": "+",
                "s": "}"
              }
            ]
          }
        ]
      }
    },
