              },
              {
                "t": "-",
                "s": "  cart.items.push({ sku: item.sku, qty: item.qty, price: product.price });"
              },
              {
                "t": "+",
                "s": "  const existing = cart.items.find((i) => i.sku === item.sku);"
              },
              {
                "t": "+",
                "s": "  if (existing) existing.qty += item.qty;"
              },
              {
                "t": "+",
                "s": "  else cart.items.push({ sku: item.sku, qty: item.qty, price: product.price });"
              },
              {
                "t": " ",
                "s": "  cart.total = {"
              },
              {
                "t": " ",
                "s": "    amount: cart.items.reduce((sum, i) => sum + i.price.amount * i.qty, 0),"
              },
              {
                "t": " ",
                "s": "    currency: 'USD',"
              },
              {
                "t": " ",
                "s": "  };"
              },
              {
                "t": " ",
                "s": "  carts.set(id, cart);"
              },
              {
