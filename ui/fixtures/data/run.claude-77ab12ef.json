                "s": "import { AsyncLocalStorage } from 'node:async_hooks';"
              },
              {
                "t": "+",
                "s": "import { randomUUID } from 'node:crypto';"
              },
              {
                "t": "+",
                "s": "import type { Middleware } from '../types';"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "const store = new AsyncLocalStorage<string>();"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "/** The id of the request being handled, or undefined outside a request. */"
              },
              {
                "t": "+",
                "s": "export const currentRequestId = () => store.getStore();"
              },
              {
                "t": "+",
                "s": ""
              },
              {
                "t": "+",
                "s": "export function requestId(header = 'x-request-id'): Middleware {"
              },
              {
                "t": "+",
                "s": "  return async (ctx, next) => {"
              },
              {
                "t": "+",
                "s": "    const incoming = ctx.headers.get(header);"
              },
              {
                "t": "+",
                "s": "    const id = incoming && incoming.length <= 64 ? incoming : randomUUID();"
              },
              {
                "t": "+",
                "s": "    ctx.requestId = id;"
              },
              {
                "t": "+",
                "s": "    await store.run(id, next);"
              },
              {
                "t": "+",
                "s": "  };"
              },
              {
                "t": "+",
                "s": "}"
              }
            ]
          }
