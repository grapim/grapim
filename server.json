{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.twfly104/grapim",
  "description": "See what every coding agent changed and undo any agent's run. File claims across worktrees, per-line blame, per-run undo.",
  "repository": { "url": "https://github.com/twfly104/grapim", "source": "github" },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "grapim",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
