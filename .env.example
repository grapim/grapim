# Grapim hub. Names only: never commit real values. See docs/deploy.md.

# Required
HUB_URL=
HUB_SECRET=
HUB_DATA=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional (defaults: PORT=8080, HOST=0.0.0.0, TRUST_PROXY off; the Dockerfile sets TRUST_PROXY=1)
PORT=
HOST=
TRUST_PROXY=

# Private beta: comma-separated GitHub numeric user ids allowed to create teams.
# Leave empty only if anyone with a GitHub account may create a team.
HUB_TEAM_CREATORS=
# Per-team storage quota in MB (default 1024).
HUB_TEAM_STORAGE_MB=
# Storage quota of a platform team in MB (default 20480), instead of the per-team one.
# Each of its workspaces also has its own limit (workspace_storage_mb, PUT /v1/settings).
PLATFORM_STORAGE_MB=

# Public read-only demo at /demo (1 to turn on; off by default). Seeds the
# sample team demo-acme on start and daily; see src/hub/demo.js.
GRAPIM_DEMO=

# Optional: billing (off unless both STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_ALLOW_LIVE=

# Optional: the GitHub App for PR provenance comments and checks (docs/deploy.md).
# Without all four, its routes say "not configured" and nothing else changes.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem GitHub generates, as base64 (or the PEM itself).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# On a developer machine, for `grapim sync`
GRAPIM_HUB_URL=
GRAPIM_HUB_TOKEN=
GRAPIM_MACHINE=
