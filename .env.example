# Grapim hub. Names only: never commit real values. See docs/deploy.md.

# Required
HUB_URL=
HUB_SECRET=
HUB_DATA=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional (defaults: PORT=8080, HOST=0.0.0.0, TRUST_PROXY off; the Dockerfile sets TRUST_PROXY=1)
PORT=
HOST=
TRUST_PROXY=

# Private beta: comma-separated GitHub numeric user ids allowed to create teams.
# Leave empty only if anyone with a GitHub account may create a team.
HUB_TEAM_CREATORS=
# Per-team storage quota in MB (default 1024).
HUB_TEAM_STORAGE_MB=

# Optional: billing (off unless both STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_ALLOW_LIVE=

# On a developer machine, for `grapim sync`
GRAPIM_HUB_URL=
GRAPIM_HUB_TOKEN=
GRAPIM_MACHINE=
